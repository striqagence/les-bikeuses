# ============================================================
#  Variables d'environnement — Les Bikeuses
#  Copier ce fichier en .env et remplir les valeurs.
#  ⚠️ Ne jamais committer le fichier .env (il contient des secrets).
# ============================================================

# --- Base de données : Supabase (PostgreSQL) ---
# Récupérer la chaîne dans Supabase : Project Settings → Database → Connection string.
#
# Connexion DIRECTE (recommandée en local et pour les migrations Payload) :
DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@db.[REF_PROJET].supabase.co:5432/postgres
#
# Connexion via le POOLER (à utiliser en production serverless, ex. Vercel) :
# DATABASE_URL=postgresql://postgres.[REF_PROJET]:[MOT_DE_PASSE]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# --- Secret Payload (chiffrement des tokens JWT) ---
# Générer une valeur aléatoire, ex. : openssl rand -base64 32
PAYLOAD_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE

# --- URL publique du site (sans slash final) ---
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Secret pour authentifier les tâches cron ---
CRON_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE

# --- Secret pour valider les requêtes de prévisualisation ---
PREVIEW_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE
