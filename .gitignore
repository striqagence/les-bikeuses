# ============================================================
#  Les Bikeuses — dépôt de code custom WordPress / WooCommerce
#  Principe : on ne versionne QUE le code que l'on maîtrise
#  (le thème enfant). Pas le cœur WP, pas les plugins tiers,
#  pas les médias, pas la base de données, pas les secrets.
# ============================================================

# ----- Secrets & configuration sensible -----
wp-config.php
.env
.env.*
*.log

# ----- Système d'exploitation / éditeurs -----
.DS_Store
Thumbs.db
._*
*.swp
*~
.idea/
.vscode/

# ----- Dépendances (à réinstaller, jamais à committer) -----
node_modules/
vendor/

# ============================================================
#  WordPress : tout est ignoré par défaut dans wp-content,
#  puis on ré-autorise UNIQUEMENT le thème enfant.
# ============================================================
/wp-content/*
!/wp-content/themes/
/wp-content/themes/*
!/wp-content/themes/flatsome-child/

# Le thème parent « flatsome » est un thème commercial mis à jour
# par son éditeur : on ne le versionne pas.
# Les médias (uploads), plugins tiers, cache, etc. sont ignorés.
